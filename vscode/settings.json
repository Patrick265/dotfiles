{
    "window.zoomLevel": -0.75,
    "editor.fontFamily": "SF Mono",
    "editor.fontSize": 14,
    "editor.renderWhitespace": "none",
    "editor.overviewRulerBorder": false, // removes border from overview ruler (located on the right, same position as the scrollbar)
    "editor.hideCursorInOverviewRuler": true, // hides cursor mark in the overview ruler
    "editor.snippetSuggestions": "bottom",
    "editor.suggest.showSnippets": true,
    "editor.largeFileOptimizations": true,
    "editor.lineNumbers": "on",
    "editor.inlayHints.padding": true,
    "editor.showDeprecated": false,
    "editor.inlayHints.enabled": "on",
    "editor.renderControlCharacters": false,
    "editor.stickyScroll.enabled": false,
    "editor.guides.indentation": false,
    "editor.minimap.enabled": false,
    "extensions.autoUpdate": "on",
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/build/**": true,
        "**/sdk/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**.github": true,
        "**.o": true,
        "*.tmp*": true,
        "*.map": true,
        "**.o.*": true
    },
    "output.smartScroll.enabled": false,
    "search.showLineNumbers": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "window.titleBarStyle": "custom",
    "window.customTitleBarVisibility": "auto",
    "workbench.activityBar.location": "top",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.tree.indent": 10,
    "workbench.list.smoothScrolling": true,
    "workbench.editor.highlightModifiedTabs": false,
    "workbench.colorCustomizations": { // object that allows you to customize your color theme: https://code.visualstudio.com/docs/getstarted/theme-color-reference
        "tab.activeBorder": "#0000" // removes border to highlight active tabs (the colors formats are: #RGB, #RGBA, #RRGGBB or #RRGGBBAA)
    },
    ////////////////////////////////////////////////////////////////////////
    // PLUGINS
    ////////////////////////////////////////////////////////////////////////
    "clangd.onConfigChanged": "restart",
    "clangd.checkUpdates": true,
    "clangd.arguments": [
        "--enable-config",
        "-log=verbose",
        "-pretty",
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}"
    ],
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    "cmake.automaticReconfigure": false,
    "cmake.autoSelectActiveFolder": false,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "compact",
            "statusBarLength": 40
        },
        "workflowPreset": {
            "statusBarVisibility": "compact",
            "statusBarLength": 40
        },
        "buildTarget": {
            "statusBarVisibility": "compact"
        },
        "workflow": { "statusBarVisibility": "compact" },
        "debug":    { "statusBarVisibility": "hidden" },
        "launch":   { "statusBarVisibility": "hidden" },
        "test":     { "statusBarVisibility": "compact" },
    },
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "git.autofetch": true,
    "git.detectSubmodulesLimit": 30,
    "git.replaceTagsWhenPull": true,
    "window.commandCenter": false,
    "clangd.path": "/home/pdjo/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/23.1.0/clangd_23.1.0/bin/clangd",
    "editor.rulers": [
        80,
        120,
    ],
    // "chat.agent.enabled": false,
    // "chat.extensionTools.enabled": false,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "diffEditor.ignoreTrimWhitespace": false,
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 11,
    "terminal.integrated.fontSize": 12,
    // "chat.editor.fontSize": 11,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "debug.onTaskErrors": "abort",
    "workbench.panel.showLabels": false,
    "hediet.vscode-drawio.resizeImages": null,
    "window.menuBarVisibility": "compact",
    "terminal.integrated.suggest.suggestOnTriggerCharacters": false,
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "off",
        "arguments": "off",
        "unknown": "off"
    },
    "vsicons.dontShowNewVersionMessage": true,
    "clangd.detectExtensionConflicts": false,
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": true,
    },
    "python.analysis.exclude": [
        "extern/neuron-tools/neuron/shuffle/acp_init.py"
    ],
    "debug.breakpointsView.presentation": "tree",
    "terminal.integrated.initialHint": false,
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": true
    },
    "workbench.colorTheme": "Minimal Light",
    "git.blame.statusBarItem.enabled": true,
    "workbench.iconTheme": "vscode-icons",
    "scm.repositories.selectionMode": "single",
    "chat.viewSessions.orientation": "stacked",
}