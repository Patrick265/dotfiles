{
    "editor.fontSize": 11,
    "editor.fontFamily": "'CommitMono Nerd Font Regular','Droid Sans Mono', 'monospace', monospace",
    "editor.renderWhitespace": "none",
    "editor.snippetSuggestions": "bottom",
    "editor.suggest.showSnippets": true,
    "editor.largeFileOptimizations": true,
    "editor.lineNumbers": "on",
    "editor.inlayHints.fontFamily": "Cascadia Code Regular",
    "editor.inlayHints.padding": true,
    "editor.showDeprecated": false,
    "editor.inlayHints.enabled": "off",
    "editor.renderControlCharacters": false,
    "editor.stickyScroll.enabled": false,
    "editor.guides.indentation": false,
    "editor.minimap.enabled": false,
    "extensions.autoUpdate": "onlyEnabledExtensions",
    "chat.commandCenter.enabled": false,
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/build/**": true,
        "**/sdk/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**.github": true,
        "**.o": true,
        "*.tmp*": true,
        "*.map": true,
        "**.o.*": true
    },
    "output.smartScroll.enabled": false,
    "search.showLineNumbers": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "window.titleBarStyle": "custom",
    "window.customTitleBarVisibility": "auto",
    "workbench.activityBar.location": "top",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.tree.indent": 10,
    "workbench.list.smoothScrolling": true,
    "workbench.editor.highlightModifiedTabs": false,
    ////////////////////////////////////////////////////////////////////////
    // PLUGINS
    ////////////////////////////////////////////////////////////////////////
    "clangd.onConfigChanged": "restart",
    "clangd.checkUpdates": true,
    "clangd.arguments": [
        "--enable-config",
        "-log=verbose",
        "-pretty",
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}"
    ],
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    "cmake.automaticReconfigure": false,
    "cmake.autoSelectActiveFolder": false,
    "cmake.configureOnEdit": false,
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "compact",
            "statusBarLength": 40
        },
        "workflowPreset": {
            "statusBarVisibility": "compact",
            "statusBarLength": 40
        },
        "buildTarget": {
            "statusBarVisibility": "compact"
        },
        "workflow": {
            "statusBarVisibility": "compact"
        },
        "debug": {
            "statusBarVisibility": "hidden"
        },
        "launch": {
            "statusBarVisibility": "hidden"
        },
    },
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "git.autofetch": true,
    "git.detectSubmodulesLimit": 30,
    "git.replaceTagsWhenPull": true,
    "window.commandCenter": false,
    "window.menuBarVisibility": "compact",
    "clangd.path": "/home/pdjo/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/21.1.0/clangd_21.1.0/bin/clangd",
    "editor.rulers": [
        120,
    ],
    "chat.agent.enabled": false,
    "chat.extensionTools.enabled": false,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "diffEditor.ignoreTrimWhitespace": false,
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 11,
    "terminal.integrated.fontSize": 12,
    "chat.editor.fontSize": 11,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "debug.onTaskErrors": "abort",
    "workbench.panel.showLabels": false,
    "hediet.vscode-drawio.resizeImages": null,
    "workbench.colorTheme": "Default Light+",
}